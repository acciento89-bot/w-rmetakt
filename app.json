{
  "expo": {
    "name": "WärmeTakt",
    "slug": "waermetakt",
    "version": "1.1.0",
    "scheme": "waermetakt",
    "description": "Herstellerunabhängige Effizienzanalyse für Wärmepumpen.",
    "githubUrl": "https://github.com/acciento89-bot/w-rmetakt",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A2B"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.kamilunavo.waermetakt",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.kamilunavo.waermetakt",
      "versionCode": 5,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "./plugins/with-space-safe-ios.cjs"
    ]
  }
}
