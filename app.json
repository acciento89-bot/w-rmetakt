{
  "expo": {
    "name": "WärmeTakt",
    "slug": "waermetakt",
    "version": "1.1.0",
    "scheme": "waermetakt",
    "description": "Herstellerunabhängige Effizienzanalyse für Wärmepumpen.",
    "githubUrl": "https://github.com/acciento89-bot/w-rmetakt",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A2B"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.kamilunavo.waermetakt",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.kamilunavo.waermetakt",
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "./plugins/with-space-safe-ios.cjs",
      "./plugins/with-provider-isolated-qa.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
